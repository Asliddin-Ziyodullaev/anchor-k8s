# Copy it:  cp .env.example .env   and adjust. .env is gitignored.

# Kubeconfig file(s). Several files separated by ':' are merged, and all their contexts
# show up in the dashboard's context list.
# If empty: $KUBECONFIG -> ./kubeconfig.yaml -> ~/.kube/config
KUBECONFIG_FILE=~/.kube/dev.yaml
# KUBECONFIG_FILE=~/.kube/dev.yaml:~/.kube/staging.yaml:~/.kube/prod.yaml

# Port
PORT=9901

# SSH tunnels opened by ./start.sh before the server starts (optional).
# One tunnel = the ssh arguments; separate several tunnels with ';'.
#   SOCKS proxy:  -D 1080 user@bastion        -> in the kubeconfig cluster: proxy-url: socks5://127.0.0.1:1080
#   Port forward: -L 6443:10.0.5.4:6443 user@bastion -> in the kubeconfig cluster: server: https://127.0.0.1:6443
# Any other ssh option works too (-p 2222, -i ~/.ssh/key, -J jump-host, a Host alias from ~/.ssh/config).
# SSH_TUNNELS="-D 1080 user@bastion-prod; -L 16443:10.0.7.4:6443 user@bastion-stage"
